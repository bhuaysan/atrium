    },
    "The ZIP archive is damaged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ZIP-Archiv ist beschädigt."
          }
        }
      }
    },
    "The core could not be downloaded: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Core konnte nicht geladen werden: %@"
          }
        }
      }
    },
    "The downloaded core archive is invalid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geladene Core-Archiv ist ungültig."
          }
        }
      }
    },
    "The file is not a valid ZIP archive.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist kein gültiges ZIP-Archiv."
          }
        }
      }
    },
    "Unsupported ZIP compression method %u.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht unterstützte ZIP-Kompression %u."
          }
        }
      }
    },
    "Improves accuracy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbessert die Genauigkeit."
          }
        }
      }
    },
    "Flycast includes an HLE BIOS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flycast enthält ein HLE-BIOS."
          }
        }
      }
    },
    "The file is not an Atrium backup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist kein Atrium-Backup."
          }
        }
      }
    },
    "The backup was made by a newer version of Atrium. Update Atrium to restore it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup stammt von einer neueren Version von Atrium. Aktualisiere Atrium, um es wiederherzustellen."
          }
        }
      }
    },
    "The backup is incomplete: %lld files are missing or have the wrong size. Nothing was restored.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Das Backup ist unvollständig: %lld Datei fehlt oder hat die falsche Größe. Es wurde nichts wiederhergestellt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Das Backup ist unvollständig: %lld Dateien fehlen oder haben die falsche Größe. Es wurde nichts wiederhergestellt."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The backup is incomplete: %lld file is missing or has the wrong size. Nothing was restored."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The backup is incomplete: %lld files are missing or have the wrong size. Nothing was restored."
                }
              }
            }
          }
        }
      }
    },
    "The backup is damaged. Nothing was restored. %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup ist beschädigt. Es wurde nichts wiederhergestellt. %@"
          }
        }
      }
    },
    "before restore %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vor der Wiederherstellung %@"
          }
        }
      }
    },
    "from backup %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "aus Backup %@"
          }
        }
      }
    },
